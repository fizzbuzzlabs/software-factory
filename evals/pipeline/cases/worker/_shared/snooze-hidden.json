[
  {"name": "create a", "method": "POST", "path": "/reminders", "body": {"title": "A", "dueAt": "{tomorrow}"},
   "expect": {"status": 201, "json": {"data.status": "open"}, "absent": ["data.snoozedUntil"]}, "capture": {"a": "data.id"}},
  {"name": "create b", "method": "POST", "path": "/reminders", "body": {"title": "B", "dueAt": "{tomorrow}"},
   "expect": {"status": 201}, "capture": {"b": "data.id"}},
  {"name": "create c", "method": "POST", "path": "/reminders", "body": {"title": "C", "dueAt": "{tomorrow}"},
   "expect": {"status": 201}, "capture": {"c": "data.id"}},
  {"name": "snooze a until tomorrow", "method": "POST", "path": "/reminders/{a}/snooze", "body": {"until": "{tomorrow}"},
   "expect": {"status": 200, "json": {"data.status": "snoozed"}, "present": ["data.snoozedUntil"]}},
  {"name": "default list leaves a out", "path": "/reminders", "expect": {"status": 200, "length": {"data": 2}}},
  {"name": "full list has all three", "path": "/reminders?include=snoozed", "expect": {"status": 200, "length": {"data": 3}}},
  {"name": "until in the past", "method": "POST", "path": "/reminders/{b}/snooze", "body": {"until": "{yesterday}"},
   "expect": {"status": 422, "json": {"error.reason": "invalid_until"}}},
  {"name": "until that is not an instant", "method": "POST", "path": "/reminders/{b}/snooze", "body": {"until": "soon"},
   "expect": {"status": 422, "json": {"error.reason": "invalid_until"}}},
  {"name": "until missing", "method": "POST", "path": "/reminders/{b}/snooze", "body": {},
   "expect": {"status": 422, "json": {"error.reason": "invalid_until"}}},
  {"name": "b unchanged after rejections", "path": "/reminders/{b}",
   "expect": {"status": 200, "json": {"data.status": "open"}, "absent": ["data.snoozedUntil"]}},
  {"name": "complete b", "method": "POST", "path": "/reminders/{b}/complete", "expect": {"status": 200, "json": {"data.status": "done"}}},
  {"name": "a done reminder can't be snoozed", "method": "POST", "path": "/reminders/{b}/snooze", "body": {"until": "{tomorrow}"},
   "expect": {"status": 409, "json": {"error.reason": "already_done"}}},
  {"name": "missing reminder", "method": "POST", "path": "/reminders/no-such-id/snooze", "body": {"until": "{tomorrow}"},
   "expect": {"status": 404, "json": {"error.reason": "not_found"}}},
  {"name": "complete the snoozed a", "method": "POST", "path": "/reminders/{a}/complete",
   "expect": {"status": 200, "json": {"data.status": "done"}, "absent": ["data.snoozedUntil"]}},
  {"name": "snooze c for two seconds", "method": "POST", "path": "/reminders/{c}/snooze", "body": {"until": "{in_2s}"},
   "expect": {"status": 200, "json": {"data.status": "snoozed"}}, "wait_ms": 3500},
  {"name": "c is open again by itself", "path": "/reminders/{c}",
   "expect": {"status": 200, "json": {"data.status": "open"}, "absent": ["data.snoozedUntil"]}},
  {"name": "default list shows c again", "path": "/reminders", "expect": {"status": 200, "length": {"data": 3}}}
]
