{
  "name": "reminders",
  "version": "0.1.0",
  "private": true,
  "description": "A small HTTP service that keeps reminders in memory.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "probe": "tsx scripts/probe.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0 && npm run lint:comments",
    "lint:comments": "python3 controls/no-comments/check.py --root .",
    "debt": "tsx scripts/debt/run.ts",
    "debt:check": "tsx scripts/debt/run.ts --check",
    "debt:baseline:update": "tsx scripts/debt/run.ts --update-baseline"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^10.14.0",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "madge": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
